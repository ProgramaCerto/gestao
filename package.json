{
  "name": "programa-certo-gestao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "vercel-build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": ">=0.1.0",
    "@supabase/supabase-js": ">=2.39.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@vitejs/plugin-react": ">=4.3.0",
    "autoprefixer": ">=10.4.0",
    "dotenv": ">=16.4.0",
    "esbuild": ">=0.21.0",
    "express": "^4.21.0",
    "html2canvas": ">=1.4.1",
    "jspdf": ">=2.5.1",
    "lucide-react": ">=0.400.0",
    "motion": ">=11.11.0",
    "nodemailer": ">=6.9.0",
    "pngjs": ">=7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": ">=4.0.0",
    "vite": ">=5.4.0",
    "vite-plugin-pwa": ">=0.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": ">=20.0.0",
    "@types/nodemailer": ">=6.4.0",
    "@types/react": ">=19.0.0",
    "@types/react-dom": ">=19.0.0",
    "tsx": ">=4.7.0",
    "typescript": ">=5.5.0"
  }
}
